# Python
.venv/
__pycache__/
*.pyc

# Data (Criteo ~3GB giai nen, Online Retail II) - khong commit len git
data/

# Output lon / notebook checkpoint
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Mang du doan tai tao lai duoc va lam repo nang them 1,7 GB. Giu lai CSV/JSON/PNG/HTML
# gon nhe duoi output/ de doc duoc truc tiep.
output/**/*.npy
output/**/*.npz
# Ngoai le: holdout dung chung cua Sprint 1, 259 KB sau khi nen int8. Khong co no thi
# khong ai tai lap duoc bang so sanh cap ma khong phai chay lai toan bo pipeline.
!output/holdout/final_test_yt.npz
# Fitted scorer for the web app: rebuild with scripts/build_champion_scorer.py.
output/product/webapp/*.joblib
# Run logs from the Sprint 3 improvement round.
output/improvement/*.log
output/development/
# Legacy root artifacts are superseded by the versioned Sprint 1/Sprint 2 release
# directories. See output/README.md for which directory is authoritative.
output/legacy/qini_comparison.csv
output/legacy/segments_baseline.csv
output/legacy/qini_curve.png
*.log
# Ngoai le: log train Causal Forest, 1,2 KB moi file. Chung chua fit_time va so dong
# split duoc trich trong report/CAUSAL_FOREST_REPORT.md, nen phai kiem chung duoc.
!output/causal_forest/preflight_*/train.log

